# Copiez ce fichier en .env.local et remplissez les valeurs depuis votre
# projet Supabase (Project Settings > API).

VITE_SUPABASE_URL=https://xxxxxxxxxxxx.supabase.co
VITE_SUPABASE_ANON_KEY=votre-cle-anon-publique

# Optionnel : clé publique VAPID pour les notifications push serveur
# (voir supabase/functions/check-budgets/README.md)
VITE_VAPID_PUBLIC_KEY=
